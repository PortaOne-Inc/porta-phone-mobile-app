{
  "name": "configurator",
  "version": "0.0.2",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean": "rimraf dist",
    "sync:base-theme": "node tool/sync-base-theme.mjs",
    "check:base-theme": "node tool/sync-base-theme.mjs --check",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "build": "nest build",
    "build:watch": "nest build --watch",
    "build:dev": "cross-env NODE_ENV=dev nest build",
    "build:stage": "cross-env NODE_ENV=stage nest build",
    "build:prod": "cross-env NODE_ENV=prod nest build",
    "start:dev": "cross-env NODE_ENV=dev nest start --watch",
    "start:stage": "cross-env NODE_ENV=stage nest start --watch",
    "start:prod": "cross-env NODE_ENV=prod node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-test \"jest --config ./test/jest-e2e.json --runInBand --forceExit\"",
    "emulators:dev": "cross-env-shell NODE_ENV=dev GOOGLE_APPLICATION_CREDENTIALS=\"$(pwd)/creds/firebase-dev.json\" firebase emulators:start --only functions --project dev",
    "emulators:stage": "cross-env-shell NODE_ENV=stage GOOGLE_APPLICATION_CREDENTIALS=\"$(pwd)/creds/firebase-stage.json\" firebase emulators:start --only functions --project stage",
    "emulators:prod": "cross-env-shell NODE_ENV=prod GOOGLE_APPLICATION_CREDENTIALS=\"$(pwd)/creds/firebase-prod.json\" firebase emulators:start --only functions --project prod",
    "shell:dev": "cross-env NODE_ENV=dev npm run build:dev && firebase functions:shell --project dev",
    "shell:stage": "cross-env NODE_ENV=stage npm run build:stage && firebase functions:shell --project stage",
    "shell:prod": "cross-env NODE_ENV=prod npm run build:prod && firebase functions:shell --project prod",
    "logs:dev": "firebase functions:log --project dev",
    "logs:stage": "firebase functions:log --project stage",
    "logs:prod": "firebase functions:log --project prod",
    "deploy:dev": "npm run build:dev && firebase deploy --only functions --project dev",
    "deploy:stage": "npm run build:stage && firebase deploy --only functions --project stage",
    "deploy:prod": "npm run build:prod && firebase deploy --only functions --project prod",
    "deploy:dev:sa": "cross-env NODE_ENV=dev GOOGLE_APPLICATION_CREDENTIALS=./creds/dev-sa.json npm run deploy:dev",
    "deploy:stage:sa": "cross-env NODE_ENV=stage GOOGLE_APPLICATION_CREDENTIALS=./creds/stage-sa.json npm run deploy:stage",
    "deploy:prod:sa": "cross-env NODE_ENV=prod GOOGLE_APPLICATION_CREDENTIALS=./creds/prod-sa.json npm run deploy:prod",
    "dev:watch": "concurrently -k -n BUILD,EMU \"npm run build:dev -- --watch\" \"npm run emulators:dev\""
  },
  "engines": {
    "node": "20"
  },
  "main": "dist/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@nestjs/common": "10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "10.4.20",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "10.4.20",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@types/multer": "2.0.0",
    "archiver": "^7.0.1",
    "class-validator": "0.14.2",
    "cross-env": "^10.1.0",
    "dotenv": "16.6.1",
    "firebase": "^12.4.0",
    "firebase-admin": "12.7.0",
    "firebase-functions": "5.1.1",
    "fireorm": "0.23.3",
    "js-yaml": "4.1.0",
    "nestjs-fireorm": "1.1.1",
    "nestjs-zod": "^5.0.1",
    "passport": "^0.7.0",
    "passport-firebase-jwt": "^1.2.1",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.1",
    "unzipper": "^0.12.3",
    "validator": "^13.15.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@nestjs/cli": "10.0.0",
    "@nestjs/schematics": "10.0.0",
    "@nestjs/testing": "10.0.0",
    "@types/archiver": "6.0.3",
    "@types/express": "4.17.23",
    "@types/jest": "^29.5.2",
    "@types/node": "20.3.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "6.0.0",
    "@types/unzipper": "0.10.10",
    "@typescript-eslint/eslint-plugin": "6.0.0",
    "@typescript-eslint/parser": "6.0.0",
    "concurrently": "^9.2.1",
    "eslint": "9.35.0",
    "firebase-functions-test": "3.1.0",
    "globals": "16.4.0",
    "jest": "^29.7.0",
    "jiti": "2.5.1",
    "prettier": "3.0.0",
    "rimraf": "6.0.1",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "9.4.3",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.1.3",
    "typescript-eslint": "8.43.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "eslintIgnore": [
    "**/*"
  ]
}
