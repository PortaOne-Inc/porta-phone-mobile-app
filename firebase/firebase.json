{
  "functions": {
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ],
    "predeploy": "npm --prefix \"$RESOURCE_DIR\" run build",
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 7980
    },
    "functions": {
      "port": 7981
    },
    "firestore": {
      "port": 7982
    },
    "hosting": {
      "port": 7984
    },
    "ui": {
      "enabled": true,
      "port": 7985
    },
    "singleProjectMode": true
  }
}
